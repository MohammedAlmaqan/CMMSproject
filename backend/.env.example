# CMMS Backend Configuration
# Copy this file to .env and adjust values

# Database connection (PostgreSQL). connection_limit and pool_timeout are Prisma
# pool parameters fixing the P2028 pool-exhaustion issue (ADMIN_GUIDE 14.3):
# pool_timeout is in MILLISECONDS (30000 = 30s), not seconds.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/cmms?connection_limit=20&pool_timeout=30000"

# JWT secret key (change for production!)
JWT_SECRET="change-this-to-a-random-secret-key"

# JWT token expiration time
JWT_EXPIRES_IN=28800

# Server port
PORT=4000

# Allowed CORS origins (comma-separated) for browser clients
CORS_ORIGINS=http://localhost:3000

# Log level
LOG_LEVEL=info

# Bind address. Use 127.0.0.1 when behind IIS so port 4000 is not externally reachable.
# Use 0.0.0.0 only for direct-access dev or when no reverse proxy is used.
BIND_HOST=0.0.0.0

# PM scheduler cron (default 02:00 daily). See docs/ARCHITECTURE.md §Scheduler.
PM_SCHEDULER_CRON=0 2 * * *
