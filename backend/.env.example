# CMMS Backend Configuration
# Copy this file to .env and adjust values

# Database connection (PostgreSQL). connection_limit and pool_timeout are Prisma
# pool parameters fixing the P2028 pool-exhaustion issue (ADMIN_GUIDE 14.3):
# pool_timeout is in MILLISECONDS (30000 = 30s), not seconds.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/cmms?connection_limit=20&pool_timeout=30000"

# JWT secret key (change for production!)
JWT_SECRET="change-this-to-a-random-secret-key"

# Access-token lifetime in seconds (default 900 = 15 minutes). Deliberately short:
# a session is kept alive by the rotating refresh cookie, not by a long-lived JWT.
# JWT_EXPIRES_IN is still accepted as a legacy alias for this value.
ACCESS_TOKEN_TTL=900

# Absolute session lifetime in seconds (default 28800 = 8 hours), inherited across
# refresh-token rotations.
REFRESH_TOKEN_TTL=28800

# Server-side idle window in milliseconds (default 1800000 = 30 minutes). A session
# idle longer than this is refused even if its access token has not expired.
SESSION_IDLE_MS=1800000

# Server port
PORT=4000

# Allowed CORS origins (comma-separated) for browser clients
CORS_ORIGINS=http://localhost:3000

# Log level
LOG_LEVEL=info

# Bind address. Defaults to 127.0.0.1 (loopback), so port 4000 is not externally
# reachable and only a local reverse proxy (IIS) can reach it.
# Set 0.0.0.0 only for direct-access dev or when no reverse proxy is used.
BIND_HOST=127.0.0.1

# PM scheduler cron (default 02:00 daily). See docs/ARCHITECTURE.md §Scheduler.
PM_SCHEDULER_CRON=0 2 * * *
