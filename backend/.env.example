# CMMS Backend Configuration
# Copy this file to .env and adjust values

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/cmms"

# JWT secret key (change for production!)
JWT_SECRET="change-this-to-a-random-secret-key"

# JWT token expiration time
JWT_EXPIRES_IN=28800

# Server port
PORT=4000

# Allowed CORS origins (comma-separated) for browser clients
CORS_ORIGINS=http://localhost:3000

# Log level
LOG_LEVEL=info

# PM scheduler cron (default 02:00 daily). See docs/ARCHITECTURE.md §Scheduler.
PM_SCHEDULER_CRON=0 2 * * *
