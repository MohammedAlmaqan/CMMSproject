generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId        String   @id @default(uuid())
  username      String   // F3: partial unique index (isDeleted=false)
  passwordHash  String
  fullName      String
  email         String
  role          String   // Administrator, Maintenance Planner, Maintenance Supervisor, Technician, Requester, View-Only
  workCenterId  String?
  isActive         Boolean    @default(true)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLogin        DateTime?
  createdBy     String   @default("system")
  createdDate   DateTime @default(now())
  modifiedBy    String   @default("system")
  modifiedDate  DateTime @updatedAt
  isDeleted     Boolean  @default(false)

  workCenter        WorkCenter?       @relation(fields: [workCenterId], references: [workCenterId])
  assignedWOs       WorkOrder[]       @relation("Supervisor")
  reportedWOs       WorkOrder[]       @relation("ReportedBy")
  reportedNotifs    Notification[]    @relation("ReportedBy")
  laborEntries      LaborEntry[]
  auditLogs         AuditLogEntry[]
  comments          Comment[]
  workOrderChecklists WorkOrderChecklist[]
  refreshTokens     RefreshToken[]
  systemAlerts      SystemAlert[]
  workOrderSnapshots WorkOrderSnapshot[]
}

model RefreshToken {
  tokenId    String   @id @default(uuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revoked    Boolean  @default(false)

  user User @relation(fields: [userId], references: [userId])
}

model FunctionalLocation {
  functionalLocationId String   @id @default(uuid())
  locationCode         String   // F3: partial unique index (isDeleted=false)
  description          String
  parentLocationId     String?
  locationType         String   // Plant, Area, Unit, Sub-unit, System
  operationalStatus    String   @default("Active") // Active, Inactive
  installationDate     DateTime?
  gpsCoordinates       String?
  safetyCritical       Boolean  @default(false)
  createdBy            String   @default("system")
  createdDate          DateTime @default(now())
  modifiedBy           String   @default("system")
  modifiedDate         DateTime @updatedAt
  isDeleted            Boolean  @default(false)

  parent       FunctionalLocation?  @relation("LocationHierarchy", fields: [parentLocationId], references: [functionalLocationId])
  children     FunctionalLocation[] @relation("LocationHierarchy")
  equipment    Equipment[]
  notifications Notification[]
  workOrders   WorkOrder[]
  planTargets  MaintenancePlanTarget[]
}

model Equipment {
  equipmentId          String   @id @default(uuid())
  equipmentCode        String   // F3: partial unique index (isDeleted=false)
  name                 String
  description          String
  functionalLocationId String
  manufacturer         String
  model                String
  serialNumber         String
  assetTag             String
  equipmentClass       String
  criticality          String   // A, B, C
  installationDate     DateTime?
  warrantyExpiryDate   DateTime?
  operationalStatus    String   @default("Active") // Active, Inactive, Decommissioned
  technicalParameters  Json     @default("{}")
  createdBy            String   @default("system")
  createdDate          DateTime @default(now())
  modifiedBy          String   @default("system")
  modifiedDate        DateTime @updatedAt
  isDeleted           Boolean  @default(false)
  functionalLocation FunctionalLocation @relation(fields: [functionalLocationId], references: [functionalLocationId])
  meters             EquipmentMeter[]
  bomItems           EquipmentBOMMaterial[]
  notifications      Notification[]
  workOrders         WorkOrder[]
  maintenancePlans   MaintenancePlan[]
  planTargets        MaintenancePlanTarget[]
  taskLists          TaskList[]
}

model EquipmentMeter {
  meterId        String   @id @default(uuid())
  equipmentId    String
  meterName      String
  unitOfMeasure  String
  lastReading    Float    @default(0)
  lastReadingDate DateTime?
  createdBy      String   @default("system")
  createdDate    DateTime @default(now())
  modifiedBy     String   @default("system")
  modifiedDate   DateTime @updatedAt
  isDeleted      Boolean  @default(false)

  equipment      Equipment        @relation(fields: [equipmentId], references: [equipmentId])
  readings       MeterReading[]
  planMeters     MaintenancePlanMeter[]
}

model MeterReading {
  readingId    String   @id @default(uuid())
  meterId      String
  readingValue Float
  readingDate  DateTime
  notes        String?
  createdBy    String   @default("system")
  createdDate  DateTime @default(now())
  modifiedBy   String   @default("system")
  modifiedDate DateTime @updatedAt
  isDeleted    Boolean  @default(false)

  meter EquipmentMeter @relation(fields: [meterId], references: [meterId])
}

model WorkCenter {
  workCenterId       String   @id @default(uuid())
  code               String   // F3: partial unique index (isDeleted=false)
  name               String
  dailyCapacityHours Float
  costRatePerHour    Float
  isActive           Boolean  @default(true)
  createdBy          String   @default("system")
  createdDate        DateTime @default(now())
  modifiedBy         String   @default("system")
  modifiedDate       DateTime @updatedAt
  isDeleted          Boolean  @default(false)

  crafts       Craft[]
  workOrders   WorkOrder[]
  users        User[]
  taskLists    TaskList[]
  maintenancePlans MaintenancePlan[]
}

model Craft {
  craftId      String   @id @default(uuid())
  workCenterId String
  craftCode    String
  description  String
  hourlyRate   Float
  createdBy    String   @default("system")
  createdDate  DateTime @default(now())
  modifiedBy   String   @default("system")
  modifiedDate DateTime @updatedAt
  isDeleted    Boolean  @default(false)

  workCenter          WorkCenter           @relation(fields: [workCenterId], references: [workCenterId])
  workOrderOperations WorkOrderOperation[]
  taskListOperations  TaskListOperation[]
}

model Material {
  materialId   String   @id @default(uuid())
  materialCode String   // F3: partial unique index (isDeleted=false)
  description  String
  unitOfMeasure String
  standardCost Float
  currentStock Float   @default(0)
  createdBy    String   @default("system")
  createdDate  DateTime @default(now())
  modifiedBy   String   @default("system")
  modifiedDate DateTime @updatedAt
  isDeleted    Boolean  @default(false)

  bomItems     EquipmentBOMMaterial[]
  woMaterials  WorkOrderMaterial[]
  taskListMaterials TaskListMaterial[]
}

model EquipmentBOMMaterial {
  bomId       String @id @default(uuid())
  equipmentId String
  materialId  String
  quantity    Float
  createdBy   String   @default("system")
  createdDate DateTime @default(now())
  modifiedBy  String   @default("system")
  modifiedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  equipment Equipment @relation(fields: [equipmentId], references: [equipmentId])
  material  Material  @relation(fields: [materialId], references: [materialId])
}

model FailureCode {
  failureCodeId  String   @id @default(uuid())
  parentCodeId   String?
  code           String
  description    String
  createdBy      String   @default("system")
  createdDate    DateTime @default(now())
  modifiedBy     String   @default("system")
  modifiedDate   DateTime @updatedAt
  isDeleted      Boolean  @default(false)

  parent FailureCode?  @relation("FailureCodeHierarchy", fields: [parentCodeId], references: [failureCodeId])
  children FailureCode[] @relation("FailureCodeHierarchy")
}

model CauseCode {
  causeCodeId  String   @id @default(uuid())
  code         String
  description  String
  createdBy    String   @default("system")
  createdDate  DateTime @default(now())
  modifiedBy   String   @default("system")
  modifiedDate DateTime @updatedAt
  isDeleted    Boolean  @default(false)
}

model TaskList {
  taskListId     String   @id @default(uuid())
  code           String   // F3: partial unique index (isDeleted=false)
  description    String
  equipmentClass String?
  equipmentId    String?
  workCenterId   String
  createdBy      String   @default("system")
  createdDate    DateTime @default(now())
  modifiedBy     String   @default("system")
  modifiedDate   DateTime @updatedAt
  isDeleted      Boolean  @default(false)

  equipment      Equipment?           @relation(fields: [equipmentId], references: [equipmentId])
  workCenter     WorkCenter           @relation(fields: [workCenterId], references: [workCenterId])
  operations     TaskListOperation[]
  maintenancePlans MaintenancePlan[]
}

model TaskListOperation {
  taskOperationId  String   @id @default(uuid())
  taskListId       String
  sequenceNumber   Int
  description      String
  craftId          String
  plannedHours     Float
  numberOfTechnicians Int
  createdBy        String   @default("system")
  createdDate      DateTime @default(now())
  modifiedBy       String   @default("system")
  modifiedDate     DateTime @updatedAt
  isDeleted        Boolean  @default(false)

  taskList TaskList @relation(fields: [taskListId], references: [taskListId])
  craft    Craft    @relation(fields: [craftId], references: [craftId])
  materials TaskListMaterial[]
}

/// SOW 3.1.4: a task list carries the materials its steps require. The
/// requirement hangs off the step rather than the list, because the part a step
/// needs is what the store has to have on the shelf before that step starts. A
/// list-level requirement cannot say which step is blocked when the part is
/// missing.
model TaskListMaterial {
  taskListMaterialId String @id @default(uuid())
  taskOperationId    String
  materialId         String
  quantity           Float

  createdBy    String   @default("system")
  createdDate  DateTime @default(now())
  modifiedBy   String   @default("system")
  modifiedDate DateTime @updatedAt
  isDeleted    Boolean  @default(false)

  taskOperation TaskListOperation @relation(fields: [taskOperationId], references: [taskOperationId])
  material      Material          @relation(fields: [materialId], references: [materialId])

  // F3: @@unique([taskOperationId, materialId]) replaced by partial unique
  // index (isDeleted=false) so a soft-deleted requirement frees its pair.
  @@index([materialId], map: "TaskListMaterial_materialId_idx")
}

model Notification {
  notificationId      String   @id @default(uuid())
  notificationNumber  String   // F3: partial unique index (isDeleted=false)
  type                String   // M1, M2, M3
  priority            String   // High, Medium, Low
  functionalLocationId String
  equipmentId         String?
  reportedByUserId    String
  description         String
  // SOW 3.2.2 names "Damages/observations" as a key field in its own right,
  // separate from the description. What was actually found at the asset is the
  // evidence a failure analyst needs, and folding it into `description` loses
  // it: the description is the caller's summary at raise time, the observation
  // is what somebody saw. Nullable, because a notification is raised before
  // anyone has inspected anything.
  damagesObservations String?
  breakdownFlag       Boolean  @default(false)
  status              String   @default("Open") // Open, In Process, Completed, Converted
  createdBy           String   @default("system")
  createdDate         DateTime @default(now())
  modifiedBy          String   @default("system")
  modifiedDate        DateTime @updatedAt
  isDeleted           Boolean  @default(false)

  functionalLocation FunctionalLocation @relation(fields: [functionalLocationId], references: [functionalLocationId])
  equipment          Equipment?         @relation(fields: [equipmentId], references: [equipmentId])
  reportedBy         User               @relation("ReportedBy", fields: [reportedByUserId], references: [userId])
  workOrders         WorkOrderNotifLink[]
  maintenancePlans   MaintenancePlan[]
}

model WorkOrder {
  workOrderId         String   @id @default(uuid())
  woNumber            String   // F3: partial unique index (isDeleted=false)
  type                String   // CM, PM, PdM, EM, CAL
  priority            String   // High, Medium, Low
  status              String   @default("Draft") // Draft, Planned, Scheduled, In Progress, Suspended, Completed, Closed, Cancelled
  functionalLocationId String
  equipmentId         String?
  description         String
  workCenterId        String
  supervisorUserId    String
  // SOW 3.3.3 lists "Reported By" as a header field in its own right, separate
  // from "Assigned Supervisor". createdBy records who raised the work-order
  // record; for a corrective job converted from a notification that is the
  // planner, not the person who saw the broken machine, so the two cannot share
  // a column. Backfilled from createdBy so every existing work order names
  // somebody.
  reportedByUserId    String
  plannedStart        DateTime?
  plannedFinish       DateTime?
  actualStart         DateTime?
  actualFinish        DateTime?
  costCenterCode      String   @default("")
  internalOrder       String   @default("")
  breakdownFlag       Boolean  @default(false)
  safetyCriticalFlag  Boolean  @default(false)
  plannedCost         Float    @default(0)
  actualCost          Float    @default(0)
  createdBy           String   @default("system")
  createdDate         DateTime @default(now())
  modifiedBy          String   @default("system")
  modifiedDate        DateTime @updatedAt
  isDeleted           Boolean  @default(false)
  sourcePlanId        String?
  sourcePlanCycle     String?

  // F3: @@unique([sourcePlanId, sourcePlanCycle]) replaced by partial index (isDeleted=false)

  functionalLocation FunctionalLocation @relation(fields: [functionalLocationId], references: [functionalLocationId])
  equipment          Equipment?         @relation(fields: [equipmentId], references: [equipmentId])
  workCenter         WorkCenter         @relation(fields: [workCenterId], references: [workCenterId])
  supervisor         User     @relation("Supervisor", fields: [supervisorUserId], references: [userId])
  reportedBy         User     @relation("ReportedBy", fields: [reportedByUserId], references: [userId])
  operations         WorkOrderOperation[]
  woMaterials        WorkOrderMaterial[]
  externalServices   ExternalServiceCost[]
  checklists         WorkOrderChecklist[]
  costSplits         CostSplit[]
  notifications      WorkOrderNotifLink[]
  snapshots          WorkOrderSnapshot[]
}

// SOW 3.6 "Work Order History". A complete, immutable copy of the work order
// taken at each status change. The absence of modifiedBy/modifiedDate/isDeleted
// is deliberate: this record cannot be edited, retired or hidden, which is what
// "stored as immutable records" asks for. The parent can be soft-deleted and the
// history survives; a hard delete of a work order row is refused (Restrict)
// once its history exists.
model WorkOrderSnapshot {
  snapshotId    String   @id @default(uuid())
  workOrderId   String
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [workOrderId], onDelete: Restrict)
  // The status the snapshot captures, repeated for queryability even though the
  // JSON below carries it too.
  status        String
  // Frozen copy of the work order's record at capture time: every scalar field,
  // dates as ISO strings, keys sorted so consecutive snapshots diff cleanly.
  snapshot      Json
  takenByUserId String
  takenBy       User     @relation(fields: [takenByUserId], references: [userId])
  takenAt       DateTime @default(now())

  @@index([workOrderId, takenAt])
}

model WorkOrderNotifLink {
  workOrderId    String
  notificationId String
  createdBy      String   @default("system")
  createdDate    DateTime @default(now())
  modifiedBy     String   @default("system")
  modifiedDate   DateTime @updatedAt
  isDeleted      Boolean  @default(false)

  workOrder     WorkOrder    @relation(fields: [workOrderId], references: [workOrderId])
  notification  Notification @relation(fields: [notificationId], references: [notificationId])

  @@id([workOrderId, notificationId])
}

model WorkOrderOperation {
  operationId        String   @id @default(uuid())
  workOrderId        String
  sequenceNumber     Int
  description        String
  craftId            String
  plannedHours       Float
  numberOfTechnicians Int    @default(1)
  actualHours        Float   @default(0)
  status             String   @default("Pending") // Pending, In Progress, Completed
  createdBy          String   @default("system")
  createdDate        DateTime @default(now())
  modifiedBy         String   @default("system")
  modifiedDate       DateTime @updatedAt
  isDeleted          Boolean  @default(false)

  workOrder  WorkOrder    @relation(fields: [workOrderId], references: [workOrderId])
  craft      Craft        @relation(fields: [craftId], references: [craftId])
  laborEntries LaborEntry[]
  /// Materials issued to this operation. See WorkOrderMaterial.operationId.
  materials WorkOrderMaterial[]
}

model WorkOrderMaterial {
  woMaterialId       String @id @default(uuid())
  workOrderId        String
  materialId         String
  /// SOW 3.1.5: a material is issued to the operation that needs it. Nullable
  /// because a part can be common to the whole job, and existing rows predate
  /// the link. When set, this is the operation the issue belongs to and it must
  /// be an operation on this same work order.
  operationId        String?
  plannedQuantity    Float
  actualQuantity     Float  @default(0)
  unitCost           Float  @default(0)
  reservationQuantity Float @default(0)
  createdBy           String   @default("system")
  createdDate         DateTime @default(now())
  modifiedBy          String   @default("system")
  modifiedDate        DateTime @updatedAt
  isDeleted           Boolean  @default(false)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [workOrderId])
  material  Material  @relation(fields: [materialId], references: [materialId])
  operation WorkOrderOperation? @relation(fields: [operationId], references: [operationId])
}

model LaborEntry {
  laborEntryId String   @id @default(uuid())
  operationId  String
  userId       String
  hoursWorked  Float
  entryDateTime DateTime @default(now())
  notes        String?
  createdBy    String   @default("system")
  createdDate  DateTime @default(now())
  modifiedBy   String   @default("system")
  modifiedDate DateTime @updatedAt
  isDeleted    Boolean  @default(false)

  operation WorkOrderOperation @relation(fields: [operationId], references: [operationId])
  user      User               @relation(fields: [userId], references: [userId])
}

model ExternalServiceCost {
  serviceCostId String @id @default(uuid())
  workOrderId   String
  vendor        String
  description   String
  cost          Float
  invoiceRef    String
  // SOW 3.3.6: travel and permits are "additional miscellaneous costs ... as
  // line items", and without a discriminator they are indistinguishable from a
  // contractor service. Free text plus a zod enum, consistent with every other
  // status/type column here (see v1.1-4). 'Service' is the contractor case and
  // the default, so an existing caller that sends nothing keeps its meaning.
  category      String @default("Service")
  createdBy     String   @default("system")
  createdDate   DateTime @default(now())
  modifiedBy    String   @default("system")
  modifiedDate  DateTime @updatedAt
  isDeleted     Boolean  @default(false)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [workOrderId])
}

model SafetyChecklistTemplate {
  checklistTemplateId String   @id @default(uuid())
  name                String
  description         String
  isMandatory         Boolean  @default(false)
  createdBy           String   @default("system")
  createdDate         DateTime @default(now())
  modifiedBy          String   @default("system")
  modifiedDate        DateTime @updatedAt
  isDeleted           Boolean  @default(false)

  items      ChecklistItem[]
  woChecklists WorkOrderChecklist[]
}

model ChecklistItem {
  itemId              String @id @default(uuid())
  checklistTemplateId String
  sequenceNumber      Int
  description         String
  createdBy           String   @default("system")
  createdDate         DateTime @default(now())
  modifiedBy          String   @default("system")
  modifiedDate        DateTime @updatedAt
  isDeleted           Boolean  @default(false)

  template SafetyChecklistTemplate @relation(fields: [checklistTemplateId], references: [checklistTemplateId])
  responses WorkOrderChecklistItem[]
}

model WorkOrderChecklist {
  woChecklistId       String   @id @default(uuid())
  workOrderId         String
  checklistTemplateId String
  status              String   @default("Pending") // Pending, In Progress, Completed
  signedBy            String?
  signedDate          DateTime?
  createdBy           String   @default("system")
  createdDate         DateTime @default(now())
  modifiedBy          String   @default("system")
  modifiedDate        DateTime @updatedAt
  isDeleted           Boolean  @default(false)

  workOrder  WorkOrder              @relation(fields: [workOrderId], references: [workOrderId])
  template   SafetyChecklistTemplate @relation(fields: [checklistTemplateId], references: [checklistTemplateId])
  items      WorkOrderChecklistItem[]
  signer     User?                   @relation(fields: [signedBy], references: [userId])
}

model WorkOrderChecklistItem {
  woChecklistItemId String @id @default(uuid())
  woChecklistId     String
  itemId            String
  // Nullable, and no longer pre-filled with 'NA' at attach time. `null` means
  // the item has not been answered yet, which is what lets the SOW 3.3.7 gate
  // distinguish an unacknowledged mandatory checklist from a completed one.
  // 'NA' stays a valid deliberate answer for questions that do not apply.
  response          String?  // Yes, No, NA, or null when unanswered
  comment           String?
  createdBy         String   @default("system")
  createdDate       DateTime @default(now())
  modifiedBy        String   @default("system")
  modifiedDate      DateTime @updatedAt
  isDeleted         Boolean  @default(false)

  woChecklist WorkOrderChecklist @relation(fields: [woChecklistId], references: [woChecklistId])
  item        ChecklistItem      @relation(fields: [itemId], references: [itemId])
}

model MaintenancePlan {
  planId              String   @id @default(uuid())
  // F3: planCode is NOT `@unique` here; uniqueness is enforced for active rows only
  // by a partial unique index (see migration `*_partial_unique_index`):
  //   CREATE UNIQUE INDEX "MaintenancePlan_planCode_active_key"
  //     ON "MaintenancePlan" ("planCode") WHERE "isDeleted" = false;
  planCode            String
  description         String
  equipmentId         String?
  functionalLocationId String?
  workCenterId        String
  taskListId          String
  strategyType        String   // Time, Meter, Combined
  intervalValue       Int
  intervalUnit        String   // Days, Weeks, Months
  callHorizonValue    Int      @default(7)
  callHorizonUnit     String   @default("Days") // Days, Units
  startDate           DateTime
  endDate             DateTime?
  // SOW 3.4.1 names Priority as a plan field. The generated work order used to
  // be hard-coded to 'Medium', so a plan could not express that inspecting a
  // safety-critical asset outranks routine lubrication.
  priority            String   @default("Medium") // High, Medium, Low
  // SOW 3.4.3: the status a generated work order starts in is the planner's
  // choice. Draft keeps it in the queue for triage; Planned means the plan is
  // trusted enough to schedule without a second look.
  generatedWorkOrderStatus String @default("Draft") // Draft, Planned
  // SOW 3.4.1 and 3.4.3: a plan may carry an associated notification, which is
  // created and linked to the work order each time the plan generates one.
  notificationId      String?
  activeFlag          Boolean  @default(true)
  createdBy           String   @default("system")
  createdDate         DateTime @default(now())
  modifiedBy          String   @default("system")
  modifiedDate        DateTime @updatedAt
  isDeleted           Boolean  @default(false)

  equipment  Equipment?           @relation(fields: [equipmentId], references: [equipmentId])
  workCenter WorkCenter           @relation(fields: [workCenterId], references: [workCenterId])
  taskList   TaskList             @relation(fields: [taskListId], references: [taskListId])
  notification Notification?      @relation(fields: [notificationId], references: [notificationId])
  planMeters MaintenancePlanMeter[]
  // D-10 / SOW 3.4.1: a plan targets Equipment or Functional Location "or a
  // list". This join table is the source of truth for what a plan covers, so
  // one fleet-wide plan can drive many assets. The single `equipmentId` and
  // `functionalLocationId` columns above are retained as a compatibility mirror
  // of the first target and are backfilled from existing plans.
  targets    MaintenancePlanTarget[]
}

model MaintenancePlanTarget {
  planTargetId         String @id @default(uuid())
  planId               String
  equipmentId          String?
  functionalLocationId String?
  createdBy            String   @default("system")
  createdDate          DateTime @default(now())
  modifiedBy           String   @default("system")
  modifiedDate         DateTime @updatedAt
  isDeleted            Boolean  @default(false)

  // CASCADE: a target row is only meaningful as part of its plan's definition.
  // Deleting the plan must take its targeting with it, or the rows are orphans
  // describing assets nobody scheduled.
  plan               MaintenancePlan     @relation(fields: [planId], references: [planId], onDelete: Cascade)
  equipment          Equipment?          @relation(fields: [equipmentId], references: [equipmentId])
  functionalLocation FunctionalLocation? @relation(fields: [functionalLocationId], references: [functionalLocationId])

  // Postgres treats NULLs as distinct in a unique index, so these stop a
  // repeated non-null target but cannot stop two all-NULL rows. The CHECK
  // constraint in the migration is what makes "exactly one target" real.
  // F3: @@unique([planId, equipmentId]) replaced by a partial unique index
  // (isDeleted=false) so a soft-deleted target frees its pair for re-add.
  // F3: @@unique([planId, functionalLocationId]) likewise.
  @@index([equipmentId])
  @@index([functionalLocationId])
}

model MaintenancePlanMeter {
  planMeterId  String @id @default(uuid())
  planId       String
  meterId      String
  meterInterval Float
  createdBy     String   @default("system")
  createdDate   DateTime @default(now())
  modifiedBy    String   @default("system")
  modifiedDate  DateTime @updatedAt
  isDeleted     Boolean  @default(false)

  plan  MaintenancePlan @relation(fields: [planId], references: [planId])
  meter EquipmentMeter  @relation(fields: [meterId], references: [meterId])
}

model CostSplit {
  splitId         String @id @default(uuid())
  workOrderId     String
  costCenterCode  String
  percentage      Float
  createdBy       String   @default("system")
  createdDate     DateTime @default(now())
  modifiedBy      String   @default("system")
  modifiedDate    DateTime @updatedAt
  isDeleted       Boolean  @default(false)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [workOrderId])
}

model AuditLogEntry {
  auditId    String   @id @default(uuid())
  tableName  String
  recordId   String
  action     String   // Create, Update, Delete
  fieldName  String?
  oldValue   String?
  newValue   String?
  userId     String
  ipAddress  String?
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [userId])
}

model SystemAlert {
  alertId           String   @id @default(uuid())
  alertType         String   // WO_Assigned, WO_Overdue, PM_Generation, High_Priority_Notification
  userId            String
  title             String
  message           String
  isRead            Boolean  @default(false)
  createdDate       DateTime @default(now())
  relatedEntityId   String?
  relatedEntityType String?
  createdBy         String   @default("system")
  modifiedBy        String   @default("system")
  modifiedDate      DateTime @updatedAt
  isDeleted         Boolean  @default(false)

  user User @relation(fields: [userId], references: [userId])
}

model Comment {
  commentId   String   @id @default(uuid())
  entityType  String   // WorkOrder, Notification, Equipment
  entityId    String
  userId      String
  content     String
  createdDate DateTime @default(now())
  createdBy   String   @default("system")
  modifiedBy  String   @default("system")
  modifiedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  user User @relation(fields: [userId], references: [userId])
}

model Attachment {
  attachmentId      String   @id @default(uuid())
  entityType        String   // 'WorkOrder' | 'Notification' | 'Equipment' (start with WorkOrder)
  entityId          String
  originalName      String
  mimeType          String
  sizeBytes         Int
  storagePath       String   // relative path under backend/uploads/
  uploadedByUserId  String
  createdBy         String
  createdDate       DateTime @default(now())
  modifiedBy        String
  modifiedDate      DateTime @default(now())
  isDeleted         Boolean  @default(false)

  @@index([entityType, entityId, isDeleted])
}

model SystemConfig {
  configId String @id @default(uuid())
  // F3: `key` is NOT `@unique` here; uniqueness is enforced for active rows only
  // by a partial unique index (see migration for the sweep):
  //   CREATE UNIQUE INDEX "SystemConfig_key_active_key"
  //     ON "SystemConfig" ("key") WHERE "isDeleted" = false;
  key        String
  value      String
  createdBy  String   @default("system")
  createdDate DateTime @default(now())
  modifiedBy String   @default("system")
  modifiedDate DateTime @updatedAt
  isDeleted  Boolean  @default(false)
}

model SchedulerRun {
  schedulerRunId String   @id @default(uuid())
  hostname       String
  pid            Int
  status         String   // 'running' | 'success' | 'error'
  startedAt      DateTime
  heartbeatAt    DateTime
  completedAt    DateTime?
  plansEvaluated Int      @default(0)
  wosCreated     Int      @default(0)
  wosSkipped     Int      @default(0)
  errorMessage   String?
  createdBy      String   @default("system")
  createdDate    DateTime @default(now())
  modifiedBy     String   @default("system")
  modifiedDate   DateTime @updatedAt
  isDeleted      Boolean  @default(false)

  @@index([status, heartbeatAt])
  @@index([completedAt])
}

model SequenceCounter {
  code  String @id
  value Int    @default(0)
}
