# CMMS Backend Configuration (generated by installer)
# Place this file as .env in the backend folder alongside ecosystem.config.cjs

# Database connection (PostgreSQL). connection_limit and pool_timeout are Prisma
# pool parameters fixing the P2028 pool-exhaustion issue.
# pool_timeout is in MILLISECONDS (30000 = 30s), not seconds.
DATABASE_URL="__DATABASE_URL__"

# JWT secret key (generated). Treat as a credential.
JWT_SECRET="__JWT_SECRET__"

# Access-token lifetime in seconds (default 900 = 15 minutes)
ACCESS_TOKEN_TTL=__ACCESS_TOKEN_TTL__

# Absolute session lifetime in seconds (default 28800 = 8 hours)
REFRESH_TOKEN_TTL=__REFRESH_TOKEN_TTL__

# Server-side idle window in milliseconds (default 1800000 = 30 minutes)
SESSION_IDLE_MS=__SESSION_IDLE_MS__

# Server port
PORT=__PORT__

# Allowed CORS origins (comma-separated) for browser clients
CORS_ORIGINS=__CORS_ORIGINS__

# Log level
LOG_LEVEL=__LOG_LEVEL__

# Bind address. Defaults to 127.0.0.1 (loopback) behind a reverse proxy.
BIND_HOST=__BIND_HOST__

# PM scheduler cron (default 02:00 daily)
PM_SCHEDULER_CRON=__PM_SCHEDULER_CRON__