# CMMS Backend Configuration
# Generated by the CommandPulse CMMS installer. Do not edit by hand and do not
# commit this file: it holds the database password and the JWT signing key.

# Database connection (PostgreSQL). connection_limit and pool_timeout are Prisma
# pool parameters fixing the P2028 pool-exhaustion issue (ADMIN_GUIDE 14.3):
# pool_timeout is in MILLISECONDS (30000 = 30s), not seconds.
DATABASE_URL="__DATABASE_URL__"

# JWT secret key. Generated with a 48-byte CSPRNG at install time. It signs
# every access token; treat it as a credential.
JWT_SECRET="__JWT_SECRET__"

# Access-token lifetime in seconds (default 900 = 15 minutes). Deliberately
# short: a session is kept alive by the rotating refresh cookie.
ACCESS_TOKEN_TTL=__ACCESS_TOKEN_TTL__

# Absolute session lifetime in seconds (default 28800 = 8 hours), inherited
# across refresh-token rotations.
REFRESH_TOKEN_TTL=__REFRESH_TOKEN_TTL__

# Server-side idle window in milliseconds (default 1800000 = 30 minutes). A
# session idle longer than this is refused even if its access token has not
# expired.
SESSION_IDLE_MS=__SESSION_IDLE_MS__

# Server port
PORT=__PORT__

# Allowed CORS origins (comma-separated) for browser clients
CORS_ORIGINS=__CORS_ORIGINS__

# Log level
LOG_LEVEL=__LOG_LEVEL__

# Bind address. Defaults to 127.0.0.1 (loopback), so the port is not reachable
# from the network and only a local reverse proxy can reach it.
BIND_HOST=__BIND_HOST__

# PM scheduler cron (default 02:00 daily). See docs/ARCHITECTURE.md section Scheduler.
PM_SCHEDULER_CRON=__PM_SCHEDULER_CRON__