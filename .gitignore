node_modules/
dist/
*.tsbuildinfo
.env
# Every environment file except the sample. `.env.local` alone was not enough:
# `backend/.env.deploy` was tracked and reached the v1.6.4 handover bundle with a
# real PostgreSQL credential in it.
.env.*
!.env.example
*.log
logs/
backend-out*.log
backend-err*.log
.DS_Store
Thumbs.db
*.suo
*.user
screenshots/
# The v1.6.9 installer evidence is tracked on purpose: RELEASE_NOTES.md points at
# it. The bare rule above is for working screenshots at the root, and older UAT
# captures under docs/ stay ignored.
!docs/screenshots/
docs/screenshots/*
!docs/screenshots/install_v1.6.9/
!docs/screenshots/install_v1.6.9/**
backend/uploads/
backend/service/
backups/

# Local k6 portable binary (67 MB) — fetch it with the documented download command
scripts/k6/k6.exe

# Installer build output
installer/out/

__pycache__/
