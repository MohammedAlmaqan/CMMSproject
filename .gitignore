node_modules/
dist/
*.tsbuildinfo
.env
# Every environment file except the sample. `.env.local` alone was not enough:
# `backend/.env.deploy` was tracked and reached the v1.6.4 handover bundle with a
# real PostgreSQL credential in it.
.env.*
!.env.example
*.log
logs/
backend-out*.log
backend-err*.log
.DS_Store
Thumbs.db
*.suo
*.user
screenshots/
# The v1.6.9, v1.6.10 and v1.6.11 installer evidence is tracked on purpose:
# RELEASE_NOTES.md points at it. The bare rule above is for working screenshots at
# the root, and older UAT captures under docs/ stay ignored.
!docs/screenshots/
docs/screenshots/*
!docs/screenshots/install_v1.6.9/
!docs/screenshots/install_v1.6.9/**
!docs/screenshots/install_v1.6.10/
!docs/screenshots/install_v1.6.10/**
!docs/screenshots/install_v1.6.11/
!docs/screenshots/install_v1.6.11/**
# The v1.7.0 UAT evidence is tracked for the same reason: RELEASE_NOTES.md points
# at it, and the report has to be reproducible from the shipped tree.
!docs/screenshots/uat_v1.7.0/
!docs/screenshots/uat_v1.7.0/**
backend/uploads/
backend/service/
backups/

# Local k6 portable binary (67 MB) — fetch it with the documented download command
scripts/k6/k6.exe

# Installer build output
installer/out/

__pycache__/
